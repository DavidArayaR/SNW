# =========================================
# Configuración del sistema SNW
# =========================================

# Entorno de ejecución: en "desarrollo" los envíos se limitan a los
# números de prueba definidos abajo; en "produccion" se envía a todos.
SNW_ENTORNO=desarrollo|produccion

# Método usado para enviar los mensajes:
# - simulado: no envía nada real, solo simula el flujo (para pruebas)
# - whatsapp_web: usa una sesión de WhatsApp Web
# - api_oficial: usa la API oficial de WhatsApp Business
SNW_METODO_ENVIO=simulado|whatsapp_web|api_oficial

# Números autorizados para pruebas cuando SNW_ENTORNO=desarrollo.
# Separados por coma, con código de país incluido.
SNW_NUMEROS_PRUEBA=+569XXXXXXXXX,+569YYYYYYYYY

# Tiempo de espera (en milisegundos) entre el envío de cada mensaje,
# para evitar saturar el canal o disparar límites de la API.
SNW_INTERVALO_MS=1000


# =========================================
# Configuración de la base de datos
# =========================================

# Dirección del servidor de base de datos
DB_HOST=127.0.0.1

# Puerto de conexión (3306 es el puerto por defecto de MySQL/MariaDB)
DB_PUERTO=3306

# Usuario con permisos sobre la base de datos
DB_USUARIO=root

# Contraseña del usuario de la database.
DB_CONTRASENA=tu_contraseña

# Nombre de la base de datos a la que se conecta la app
DB_NOMBRE=nombre_base_datos
