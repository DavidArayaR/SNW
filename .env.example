# =========================================
# Configuración del sistema SNW
# =========================================

# Entorno activo: define a cuál base de datos se conecta el sistema.
# En "desarrollo" los envíos se limitan a los números de prueba;
# en "produccion" se envía a todos los pacientes seleccionados.
#           desarrollo|produccion
SNW_ENTORNO=

# Método usado para enviar los mensajes:
# - simulado: no envía nada real, solo simula el flujo (para pruebas)
# - whatsapp_web: abre WhatsApp Web con el mensaje de cada paciente
# - api_oficial: usa la API oficial de WhatsApp Business
#                simulado|whatsapp_web|api_oficial
SNW_METODO_ENVIO=

# Números autorizados de cada base de datos. Separados por coma,
# con código de país incluido. Los envíos hacia ese destino solo
# saldrán hacia estos números. 
#                       +569XXXXXXXXX,+569YYYYYYYYY
SNW_NUMEROS_PRUEBA_DEV=
SNW_NUMEROS_PRUEBA_PROD=

# Tiempo de espera (en milisegundos) entre el envío de cada mensaje,
# para evitar saturar el canal o disparar límites de la API.
SNW_INTERVALO_MS=1000

# =========================================
# Configuración de correo para confirmación en producción
# =========================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=correo_emisor@gmail.com
SMTP_PASS=tu_app_password
SMTP_TLS=true

# Correo emisor desde dónde se envía el correo de confirmación
DIRECCION_CORREO_EMISOR=correo_emisor@gmail.com
# Correo destino (supervisor) - recibe la solicitud de confirmación
DIRECCION_CORREO_DESTINO=correo_destino@gmail.com

# =========================================
# API oficial de WhatsApp Business (Meta)
# =========================================

# Requeridos solo si SNW_METODO_ENVIO=api_oficial.
# Token de acceso generado en Meta for Developers
# (developers.facebook.com > WhatsApp > API Setup).
SNW_WA_TOKEN=

# ID del número autorizado para enviar (Phone number ID,
# visible en la misma página de API Setup de Meta).
SNW_WA_PHONE_ID=


# =========================================
# Base de datos de DESARROLLO
# =========================================

DB_DEV_HOST=127.0.0.1
DB_DEV_PUERTO=3306
DB_DEV_USUARIO=root
DB_DEV_CONTRASENA=
DB_DEV_NOMBRE=


# =========================================
# Base de datos de PRODUCCIÓN
# =========================================

DB_PROD_HOST=127.0.0.1
DB_PROD_PUERTO=3306
DB_PROD_USUARIO=root
DB_PROD_CONTRASENA=
DB_PROD_NOMBRE=
